{
  "expo": {
    "name": "Delivery",
    "slug": "delivery-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.delivery.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to show your delivery address and nearby vendors.",
        "NSLocationAlwaysUsageDescription": "Used for order tracking.",
        "NSCameraUsageDescription": "Used to scan QR codes for order pickup verification.",
        "NSPhotoLibraryUsageDescription": "Used to upload your profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.delivery.customer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Delivery to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "scheme": "delivery-customer",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ec4bb1e0-caa8-4a71-a1c0-fec27425ae18"
      }
    },
    "owner": "kanishk_2004"
  }
}
