{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/stores/*": ["./src/stores/*"],
      "@delivery/types": ["../../packages/types/src/index.ts"],
      "@delivery/api-client": ["../../packages/api-client/src/index.ts"],
      "@delivery/validation": ["../../packages/validation/src/index.ts"],
      "@delivery/constants": ["../../packages/constants/src/index.ts"],
      "@delivery/config": ["../../packages/config/src/index.ts"],
      "@delivery/utils": ["../../packages/utils/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
