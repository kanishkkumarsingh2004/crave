{
  "expo": {
    "name": "Blinkbite Driver",
    "slug": "blinkbite-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.delivery.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to share your location during active deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used for continuous location sharing during deliveries.",
        "NSCameraUsageDescription": "Used to scan pickup QR codes.",
        "NSPhotoLibraryUsageDescription": "Used to upload your profile photo and verification documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.delivery.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Delivery Driver to use your location for active deliveries."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "scheme": "delivery-driver",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a9346614-e832-4ce5-a59f-b57005b91cea"
      }
    },
    "owner": "kanishk_2004"
  }
}
