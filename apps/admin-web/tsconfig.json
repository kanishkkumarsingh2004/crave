{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@server/*": ["../../server/*"],
      "@delivery/types": ["../../packages/types/src/index.ts"],
      "@delivery/api-client": ["../../packages/api-client/src/index.ts"],
      "@delivery/validation": ["../../packages/validation/src/index.ts"],
      "@delivery/constants": ["../../packages/constants/src/index.ts"],
      "@delivery/ui": ["../../packages/ui/src/index.ts"],
      "@delivery/config": ["../../packages/config/src/index.ts"],
      "@delivery/database": ["../../packages/database/src/index.ts"],
      "@delivery/utils": ["../../packages/utils/src/index.ts"],
      "@delivery/auth": ["../../packages/auth/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../server/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
