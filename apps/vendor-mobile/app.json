{
  "expo": {
    "name": "Delivery Vendor",
    "slug": "delivery-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.delivery.vendor",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan order QR codes for pickup verification.",
        "NSPhotoLibraryUsageDescription": "Used to upload product images and business documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.delivery.vendor",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "scheme": "delivery-vendor",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1267d51d-aa93-4f45-8902-936462b34895"
      }
    },
    "owner": "kanishk_2004"
  }
}
