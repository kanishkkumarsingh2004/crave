generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String             @id
  name               String
  email              String             @unique
  role               String
  password_hash      String?
  phone              String?
  address            String?
  avatar             String?
  restaurant_name    String?
  cuisine            String?
  vehicle_type       String?
  license_plate      String?
  locale             String?            @default("en")
  created_at         DateTime?          @default(now())
  customer_addresses CustomerAddress[]
  driver_incentives  DriverIncentive[]
  driver_payouts     DriverPayout[]
  driver_upi         DriverUpiAccount[]
  orders             Order[]
  owned_restaurants  Restaurant[]

  @@map("users")
}

model Restaurant {
  id                  String               @id
  name                String
  cuisine             String
  rating              Float?               @default(4.8)
  commercial_model    String               @default("commission")
  commission_rate     Float?               @default(15.00)
  markup_rate         Float?               @default(0.00)
  fixed_commission    Int?                 @default(0)
  fixed_markup        Int?                 @default(0)
  payment_model       String               @default("commission")
  address             String?
  owner_id            String?
  created_at          DateTime?            @default(now())
  image               String?
  is_pure_veg         Boolean?             @default(false)
  is_dark_store       Boolean              @default(false)
  is_open             Boolean              @default(true)
  rating_count        Int?                 @default(50)
  cost_for_two        Int?                 @default(300)
  delivery_minutes    Int?                 @default(25)
  offer               String?
  latitude            Float?
  longitude           Float?
  phone               String?
  bank_account_name   String?
  bank_name           String?
  bank_account_number String?
  bank_ifsc           String?
  payout_vpa          String?
  fssai_license       String?
  gstin               String?
  gst_status          String               @default("REGISTERED")
  supplier_state      String?              @default("Karnataka")
  price_tax_mode      String               @default("TAX_INCLUSIVE")
  contract_number     String?

  commercial_contracts CommercialContract[]
  coupons              Coupon[]
  menu_items           MenuItem[]
  orders               Order[]
  picker_metrics       PickerMetric[]
  owner                User?                @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  vendor_settlements   VendorSettlement[]

  @@map("restaurants")
}

model CommercialContract {
  id                    String        @id
  restaurant_id         String
  contract_number       String        @unique
  version               Int           @default(1)
  status                String        @default("ACTIVE")
  commercial_model      String        @default("commission")
  commission_rate       Float         @default(15.00)
  markup_rate           Float         @default(0.00)
  fixed_commission      Int           @default(0)
  fixed_markup          Int           @default(0)
  commission_basis      String        @default("ORDER_SUBTOTAL")
  price_tax_mode        String        @default("TAX_INCLUSIVE")
  effective_from        DateTime      @default(now())
  effective_until       DateTime?
  created_at            DateTime      @default(now())

  restaurant            Restaurant    @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("commercial_contracts")
}

model MenuItem {
  id                    String      @id
  restaurant_id         String?
  name                  String
  category              String
  price                 Int
  description           String?
  in_stock              Boolean?    @default(true)
  image                 String?
  created_at            DateTime?   @default(now())
  is_veg                Boolean?    @default(true)
  unit                  String?
  mrp                   Int?
  stock_count           Int         @default(0)
  sku_code              String?
  hsn_sac_code          String?     @default("996331")
  price_tax_mode        String      @default("TAX_INCLUSIVE")
  custom_commission_rate Float?
  custom_markup_rate     Float?
  expiry_date           DateTime?
  restaurant            Restaurant? @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("menu_items")
}

model Order {
  id                    String      @id
  customer_id           String?
  customer_name         String
  customer_phone        String?
  customer_address      String?
  restaurant_id         String?
  restaurant_name       String
  order_type            String      @default("restaurant_food")
  destination_vendor_id String?
  payment_status        String      @default("pending")
  payment_reviewed_by   String?
  payment_reviewed_at   DateTime?
  rider_id              String?
  items                 String
  subtotal              Int
  packaging_fee         Int?        @default(20)
  delivery_fee          Int?        @default(30)
  platform_fee          Int?        @default(6)
  handling_fee          Int?        @default(5)
  gst                   Int?        @default(18)
  total_amount          Int
  status                String
  driver_name           String?
  driver_phone          String?
  payment_method        String?     @default("UPI Online")
  created_at            DateTime?   @default(now())
  delivery_otp          String?
  picker_name           String?
  tip                   Int         @default(0)
  discount_amount       Int         @default(0)
  coupon_code           String?
  commission_amount     Int?        @default(0)
  markup_amount         Int?        @default(0)
  restaurant_payout     Int?        @default(0)
  platform_revenue      Int?        @default(0)
  financial_snapshot    String?
  utr_ref               String?
  delivery_latitude     Float?
  delivery_longitude    Float?
  delivered_at          DateTime?
  customer              User?       @relation(fields: [customer_id], references: [id])
  restaurant            Restaurant? @relation(fields: [restaurant_id], references: [id])
  ledger_entries        LedgerEntry[]

  @@map("orders")
}

model Coupon {
  id               String       @id
  code             String       @unique
  description      String
  discount_type    String
  discount_value   Int
  min_order_amount Int
  max_discount     Int?
  usage_limit      Int?
  used_count       Int?         @default(0)
  is_active        Boolean?     @default(true)
  funding_source   String?      @default("SHARED")
  restaurant_share Int?         @default(50)
  expiry_date      DateTime?
  created_at       DateTime?    @default(now())
  restaurant_id    String?
  restaurant       Restaurant?  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("coupons")
}

model VendorSettlement {
  id                String      @id
  restaurant_name   String
  gross_sales       Int
  commercial_model  String      @default("commission")
  commission_rate   Int
  commission_amount Int
  markup_amount     Int?        @default(0)
  net_payout        Int
  status            String      @default("scheduled")
  payout_date       DateTime?
  restaurant_id     String?
  period_start      DateTime?
  period_end        DateTime?
  transaction_ref   String?
  restaurant        Restaurant? @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("vendor_settlements")
}

model PaymentReview {
  id           String    @id
  order_id     String
  utr_ref      String    @unique
  customer_vpa String
  amount       Int
  status       String    @default("pending")
  created_at   DateTime? @default(now())

  @@map("payment_reviews")
}

model CustomerAddress {
  id          String   @id
  customer_id String
  label       String
  address     String
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  latitude    Float?
  longitude   Float?
  customer    User     @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model PaymentConfig {
  id                      String   @id
  name                    String
  merchant_vpa            String
  merchant_name           String
  merchant_category_code  String?
  thank_you_message       String?
  ifsc_code               String?
  account_number          String?
  platform_fee            Int?
  handling_fee            Int?
  vendor_commission       Int?
  packaging_cap           Int?
  delivery_fee            Int?
  base_distance_km        Int?
  per_km_rate             Int?
  free_delivery_threshold Int?
  driver_payout_share     Int?
  surge_multiplier        Float?
  rain_fee                Int?
  night_surge_fee         Int?
  is_rain_mode_active     Boolean? @default(false)
  is_night_surge_active    Boolean? @default(false)
  enable_cash_on_delivery Boolean? @default(false)
  enable_upi_deep_link    Boolean? @default(true)
  require_utr_number      Boolean? @default(true)
  is_active               Boolean  @default(false)
  updated_at              DateTime @default(now())
  gst_rate                Float?
  gst_rate_percent        Float?

  @@map("payment_configs")
}

model DriverUpiAccount {
  id          String   @id
  driver_id   String
  vpa         String
  bank_name   String?
  is_primary  Boolean  @default(false)
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now())
  driver      User     @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@map("driver_upi_accounts")
}

model DriverPayout {
  id              String   @id
  driver_id       String
  amount          Int
  status          String   @default("pending")
  transaction_ref String?
  created_at      DateTime @default(now())
  driver          User     @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@map("driver_payouts")
}

model DriverIncentive {
  id            String    @id
  driver_id     String?
  title         String
  description   String
  reward_amount Int
  starts_at     DateTime?
  ends_at       DateTime?
  is_active     Boolean   @default(true)
  driver        User?     @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@map("driver_incentives")
}

model PickerMetric {
  id                   String     @id
  restaurant_id        String
  picker_name          String
  bay                  String?
  orders_packed        Int        @default(0)
  average_pick_seconds Int?
  accuracy_rate        Float?
  updated_at           DateTime   @default(now())
  restaurant           Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("picker_metrics")
}

model LedgerEntry {
  id               String   @id @default(cuid())
  idempotency_key  String   @unique
  event_type       String
  order_id         String
  reference_id     String?
  account_code     String
  debit_paise      Int
  credit_paise     Int
  description      String
  notes            String?
  created_at       DateTime @default(now())
  order            Order    @relation(fields: [order_id], references: [id])

  @@map("ledger_entries")
}

model DriverLocationHistory {
  id         String   @id @default(cuid())
  driver_id  String
  latitude   Float
  longitude  Float
  h3_cell    String
  timestamp  DateTime @default(now())

  @@map("driver_location_history")
}
