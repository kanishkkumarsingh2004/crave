generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id
  name               String
  email              String             @unique
  role               UserRole
  password_hash      String?
  phone              String?
  address            String?
  avatar             String?
  restaurant_name    String?
  cuisine            String?
  vehicle_type       String?
  license_plate      String?
  locale             String?            @default("en")
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  customer_addresses CustomerAddress[]
  driver_incentives  DriverIncentive[]
  driver_payouts     DriverPayout[]
  driver_upi         DriverUpiAccount[]
  orders             Order[]
  owned_restaurants  Restaurant[]

  @@index([role, created_at])
  @@map("users")
}

model Restaurant {
  id                  String               @id
  name                String
  cuisine             String
  rating              Decimal?             @default(4.8) @db.Decimal(2, 1)
  
  // Commercial & Pricing Model Settings (Section 4 & 6 of commercial-engine.md)
  commercial_model    CommercialModel      @default(commission)
  commission_rate     Decimal?             @default(15.00) @db.Decimal(5, 2)
  markup_rate         Decimal?             @default(0.00) @db.Decimal(5, 2)
  fixed_commission    Int?                 @default(0)
  fixed_markup        Int?                 @default(0)
  payment_model       CommissionModel      @default(commission)
  
  address             String?
  owner_id            String?
  created_at          DateTime?            @default(now()) @db.Timestamptz(6)
  image               String?
  is_pure_veg         Boolean?             @default(false)
  is_dark_store       Boolean              @default(false)
  is_open             Boolean              @default(true)
  rating_count        Int?                 @default(50)
  cost_for_two        Int?                 @default(300)
  delivery_minutes    Int?                 @default(25)
  offer               String?
  latitude            Decimal?             @db.Decimal
  longitude           Decimal?             @db.Decimal
  phone               String?
  bank_account_name   String?
  bank_name           String?
  bank_account_number String?
  bank_ifsc           String?
  payout_vpa          String?
  fssai_license       String?
  gstin               String?
  gst_status          GstStatus            @default(REGISTERED)
  supplier_state      String?              @default("Karnataka")
  price_tax_mode      PriceTaxMode         @default(TAX_INCLUSIVE)
  contract_number     String?

  commercial_contracts CommercialContract[]
  coupons              Coupon[]
  menu_items           MenuItem[]
  orders               Order[]
  picker_metrics       PickerMetric[]
  owner                User?                @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  vendor_settlements   VendorSettlement[]

  @@index([owner_id])
  @@index([is_open, is_dark_store])
  @@index([is_open, is_dark_store, created_at])
  @@map("restaurants")
}

model CommercialContract {
  id                    String        @id
  restaurant_id         String
  contract_number       String        @unique
  version               Int           @default(1)
  status                ContractStatus @default(ACTIVE)
  commercial_model      CommercialModel @default(commission)
  commission_rate       Decimal       @default(15.00) @db.Decimal(5, 2)
  markup_rate           Decimal       @default(0.00) @db.Decimal(5, 2)
  fixed_commission      Int           @default(0)
  fixed_markup          Int           @default(0)
  commission_basis      String        @default("ORDER_SUBTOTAL")
  price_tax_mode        PriceTaxMode  @default(TAX_INCLUSIVE)
  effective_from        DateTime      @default(now()) @db.Timestamptz(6)
  effective_until       DateTime?     @db.Timestamptz(6)
  created_at            DateTime      @default(now()) @db.Timestamptz(6)

  restaurant            Restaurant    @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@map("commercial_contracts")
}

model MenuItem {
  id                    String      @id
  restaurant_id         String?
  name                  String
  category              String
  price                 Int
  description           String?
  in_stock              Boolean?    @default(true)
  image                 String?
  created_at            DateTime?   @default(now()) @db.Timestamptz(6)
  is_veg                Boolean?    @default(true)
  unit                  String?
  mrp                   Int?
  stock_count           Int         @default(0)
  sku_code              String?
  hsn_sac_code          String?     @default("996331")
  price_tax_mode        PriceTaxMode @default(TAX_INCLUSIVE)
  custom_commission_rate Decimal?   @db.Decimal(5, 2)
  custom_markup_rate     Decimal?   @db.Decimal(5, 2)
  expiry_date           DateTime?   @db.Date
  restaurant            Restaurant? @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id, category])
  @@index([restaurant_id, in_stock, category])
  @@map("menu_items")
}

model Order {
  id                    String      @id
  customer_id           String?
  customer_name         String
  customer_phone        String?
  customer_address      String?
  restaurant_id         String?
  restaurant_name       String
  order_type            String      @default("restaurant_food")
  destination_vendor_id String?
  payment_status        PaymentStatus @default(pending)
  payment_reviewed_by   String?
  payment_reviewed_at   DateTime?   @db.Timestamptz(6)
  rider_id              String?
  items                 Json
  subtotal              Int
  packaging_fee         Int?        @default(20)
  delivery_fee          Int?        @default(30)
  platform_fee          Int?        @default(6)
  handling_fee          Int?        @default(5)
  gst                   Int?        @default(18)
  total_amount          Int
  status                OrderStatus
  driver_name           String?
  driver_phone          String?
  payment_method        String?     @default("UPI Online")
  created_at            DateTime?   @default(now()) @db.Timestamptz(6)
  delivery_otp          String?
  picker_name           String?
  tip                   Int         @default(0)
  discount_amount       Int         @default(0)
  coupon_code           String?
  
  // Financial Breakdowns Stored (Section 30)
  commission_amount     Int?        @default(0)
  markup_amount         Int?        @default(0)
  restaurant_payout     Int?        @default(0)
  platform_revenue      Int?        @default(0)

  delivery_latitude     Decimal?    @db.Decimal
  delivery_longitude    Decimal?    @db.Decimal
  delivered_at          DateTime?   @db.Timestamptz(6)
  customer              User?       @relation(fields: [customer_id], references: [id])
  restaurant            Restaurant? @relation(fields: [restaurant_id], references: [id])

  @@index([customer_id])
  @@index([restaurant_id])
  @@index([status])
  @@index([customer_id, status, created_at])
  @@index([restaurant_id, status, created_at])
  @@index([rider_id, status])
  @@map("orders")
}

model Coupon {
  id               String       @id
  code             String       @unique
  description      String
  discount_type    DiscountType
  discount_value   Int
  min_order_amount Int
  max_discount     Int?
  usage_limit      Int?
  used_count       Int?         @default(0)
  is_active        Boolean?     @default(true)
  funding_source   String?      @default("SHARED") // RESTAURANT | PLATFORM | SHARED | BANK
  restaurant_share Int?         @default(50)       // % funded by restaurant
  expiry_date      DateTime?    @db.Date
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  restaurant_id    String?
  restaurant       Restaurant?  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("coupons")
}

model VendorSettlement {
  id                String                @id
  restaurant_name   String
  gross_sales       Int
  commercial_model  CommercialModel       @default(commission)
  commission_rate   Int
  commission_amount Int
  markup_amount     Int?                  @default(0)
  net_payout        Int
  status            VendorSettlementStatus @default(scheduled)
  payout_date       DateTime?             @db.Date
  restaurant_id     String?
  period_start      DateTime?             @db.Date
  period_end        DateTime?             @db.Date
  transaction_ref   String?
  restaurant        Restaurant?           @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([restaurant_id, status, period_start])
  @@map("vendor_settlements")
}

model PaymentReview {
  id           String        @id
  order_id     String
  utr_ref      String
  customer_vpa String
  amount       Int
  status       PaymentStatus @default(pending)
  created_at   DateTime?     @default(now()) @db.Timestamptz(6)

  @@index([order_id])
  @@map("payment_reviews")
}

model CustomerAddress {
  id          String   @id
  customer_id String
  label       String
  address     String
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  latitude    Decimal? @db.Decimal
  longitude   Decimal? @db.Decimal
  customer    User     @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_addresses")
}

model PaymentConfig {
  id                      String   @id
  name                    String
  merchant_vpa            String
  merchant_name           String
  merchant_category_code  String?
  thank_you_message       String?
  ifsc_code               String?
  account_number          String?
  platform_fee            Int?
  handling_fee            Int?
  vendor_commission       Int?
  packaging_cap           Int?
  delivery_fee            Int?
  base_distance_km        Int?
  per_km_rate             Int?
  free_delivery_threshold Int?
  driver_payout_share     Int?
  surge_multiplier        Decimal? @db.Decimal
  rain_fee                Int?
  night_surge_fee         Int?
  is_rain_mode_active     Boolean? @default(false)
  is_night_surge_active    Boolean? @default(false)
  enable_cash_on_delivery Boolean? @default(false)
  enable_upi_deep_link    Boolean? @default(true)
  require_utr_number      Boolean? @default(true)
  is_active               Boolean  @default(false)
  updated_at              DateTime @default(now()) @db.Timestamptz(6)
  gst_rate                Decimal? @db.Decimal(5, 2)

  @@map("payment_configs")
}

model DriverUpiAccount {
  id          String   @id
  driver_id   String
  vpa         String
  bank_name   String?
  is_primary  Boolean  @default(false)
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  driver      User     @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@index([driver_id])
  @@map("driver_upi_accounts")
}

model DriverPayout {
  id              String              @id
  driver_id       String
  amount          Int
  status          DriverPayoutStatus  @default(pending)
  transaction_ref String?
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  driver          User                @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@index([driver_id])
  @@index([driver_id, status, created_at])
  @@map("driver_payouts")
}

model DriverIncentive {
  id            String    @id
  driver_id     String?
  title         String
  description   String
  reward_amount Int
  starts_at     DateTime? @db.Timestamptz(6)
  ends_at       DateTime? @db.Timestamptz(6)
  is_active     Boolean   @default(true)
  driver        User?     @relation(fields: [driver_id], references: [id], onDelete: Cascade)

  @@index([driver_id])
  @@map("driver_incentives")
}



model PickerMetric {
  id                   String     @id
  restaurant_id        String
  picker_name          String
  bay                  String?
  orders_packed        Int        @default(0)
  average_pick_seconds Int?
  accuracy_rate        Decimal?   @db.Decimal
  updated_at           DateTime   @default(now()) @db.Timestamptz(6)
  restaurant           Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@map("picker_metrics")
}

model DriverLocationHistory {
  id         String   @id @default(cuid())
  driver_id  String
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  h3_cell    String
  timestamp  DateTime @default(now()) @db.Timestamptz(6)

  @@index([driver_id, timestamp])
  @@index([h3_cell])
  @@map("driver_location_history")
}

enum UserRole {
  user
  restaurant_vendor
  cravexp_store_vendor
  rider
  admin
}

enum OrderStatus {
  payment_pending
  payment_submitted
  payment_verified
  sent_to_vendor
  preparing
  packing
  ready_for_pickup
  rider_assigned
  picked_up
  out_for_delivery
  delivered
  completed
  cancelled
}

enum DiscountType {
  percentage
  flat
}

enum CommercialModel {
  commission
  markup
  hybrid
}

enum CommissionModel {
  commission
  markup
  fixed
}

enum GstStatus {
  REGISTERED
  UNREGISTERED
  COMPOSITION
}

enum PriceTaxMode {
  TAX_INCLUSIVE
  TAX_EXCLUSIVE
}

enum TaxMode {
  CGST_SGST
  IGST
}

enum PaymentStatus {
  pending
  verified
  rejected
}

enum ContractStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
}

enum VendorSettlementStatus {
  scheduled
  paid
  failed
  cancelled
}

enum DriverPayoutStatus {
  pending
  paid
  failed
}
