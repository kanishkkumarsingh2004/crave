{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "JWT_SECRET",
    "WS_PORT",
    "PORT",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "NEXT_PUBLIC_WS_URL"
  ],
  "globalDependencies": [
    "prisma/schema.prisma",
    "next.config.mjs",
    "tsconfig.json",
    "package.json"
  ],
  "tasks": {
    "build:next": {
      "dependsOn": ["^build:next"],
      "inputs": [
        "app/**",
        "components/**",
        "lib/**",
        "public/**",
        "prisma/**",
        "workers/**",
        "next.config.mjs",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck:ts": {
      "inputs": [
        "app/**",
        "components/**",
        "lib/**",
        "workers/**",
        "tsconfig.json",
        "next-env.d.ts"
      ],
      "outputs": []
    },
    "test:jest": {
      "inputs": [
        "app/**",
        "components/**",
        "lib/**",
        "workers/**",
        "__tests__/**",
        "jest.config.js",
        "babel.config.js"
      ],
      "outputs": []
    },
    "test:coverage": {
      "inputs": [
        "app/**",
        "components/**",
        "lib/**",
        "workers/**",
        "__tests__/**",
        "jest.config.js",
        "babel.config.js"
      ],
      "outputs": ["coverage/**"]
    },
    "format:check:prettier": {
      "inputs": [
        "app/**",
        "components/**",
        "lib/**",
        "workers/**",
        "*.js",
        "*.ts",
        "*.mjs",
        "*.json"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:ws": {
      "cache": false,
      "persistent": true
    }
  }
}
