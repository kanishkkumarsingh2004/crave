# ==========================================
# crave. Food Delivery Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://<your-local-ip>:3000

# JWT Authentication Secret Key
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-key-here

# Neon Database Connection (PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=verify-full&channel_binding=require"

# Neon File Storage
NEON_BUCKET_UPLOADS="uploads"

# Redis Cache, Distributed Locks & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Standards-based Web Push (generate once with: pnpm push:generate-keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT="mailto:notifications@your-domain.com"

# Native driver-app push notifications (Android / Firebase Cloud Messaging)
# FIREBASE_SERVICE_ACCOUNT_JSON may be used instead of the three separate values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Native driver-app push notifications (iOS / Apple Push Notification service)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID="com.crave.driver"
# Use false for debug builds; true for TestFlight/App Store builds.
APNS_PRODUCTION="false"

# Razorpay Payments (set ALL of these or the checkout/webhook routes fail closed)
# Dashboard: https://dashboard.razorpay.com
# Use rzp_test_* keys for development and rzp_live_* keys for production only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret from Dashboard -> Settings -> Webhooks. This must match
# the secret configured for the endpoint hitting /api/webhooks/razorpay exactly.
RAZORPAY_WEBHOOK_SECRET=
# Set both to "true" (exact string) to enable payments and Route split settlement.
RAZORPAY_ENABLED="false"
RAZORPAY_ROUTE_ENABLED="false"

# Optional generic payment-webhook secret for /api/webhooks/payment (non-Razorpay
# gateways). When unset in production, that route refuses unverified events.
# PAYMENT_WEBHOOK_SECRET=

# WebSocket Server & Internal Broadcast
WS_PORT=8000
WS_HOST="localhost"
WS_BROADCAST_PORT=8000
WS_BROADCAST_HOST="localhost"
WS_INTERNAL_SECRET="your-strong-internal-broadcast-secret-here"

# Database Connection Pool Maximums (optional)
# DB_POOL_MAX=20

# Account provisioning (required only for the corresponding seed command)
# Supply unique, private values. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_USER_ID=

# Isolated load-test identities (required by db:seed:full and load tests)
SEED_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_CUSTOMER_EMAIL=
SEED_VENDOR_EMAIL=
SEED_STORE_EMAIL=
SEED_RIDER_EMAIL=
