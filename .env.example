# ==========================================
# crave. Food Delivery Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://<your-local-ip>:3000

# JWT Authentication Secret Key
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-key-here

# Neon Database Connection (PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# Neon File Storage
NEON_BUCKET_UPLOADS="uploads"

# Redis Cache, Distributed Locks & Pub/Sub
REDIS_URL="redis://localhost:6379"
