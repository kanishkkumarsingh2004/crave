# ==========================================
# crave. Food Delivery Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://<your-local-ip>:3000

# JWT Authentication Secret Key
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-key-here

# Neon Database Connection (PostgreSQL)
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# Neon File Storage
NEON_BUCKET_UPLOADS="uploads"

# Redis Cache, Distributed Locks & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Standards-based Web Push (generate once with: pnpm push:generate-keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT="mailto:notifications@your-domain.com"

# WebSocket Server & Internal Broadcast
WS_PORT=8000
WS_HOST="localhost"
WS_BROADCAST_PORT=8000
WS_BROADCAST_HOST="localhost"
WS_INTERNAL_SECRET="your-strong-internal-broadcast-secret-here"

# Database Connection Pool Maximums (optional)
# DB_POOL_MAX=20

# Account provisioning (required only for the corresponding seed command)
# Supply unique, private values. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_USER_ID=

# Isolated load-test identities (required by db:seed:full and load tests)
SEED_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_CUSTOMER_EMAIL=
SEED_VENDOR_EMAIL=
SEED_STORE_EMAIL=
SEED_RIDER_EMAIL=
