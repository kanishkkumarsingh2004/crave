# ============================================================
# BlinkBite Admin Console Environment Variables (.env.example)
# ============================================================

# Local Data Storage (JSON file database and uploads)
LOCAL_DATA_DIR="./data"
LOCAL_UPLOADS_DIR="./data/uploads"

# Base Application URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Optional Session Secret (Node crypto default is generated automatically)
# AUTH_SECRET="your-strong-secret-key-here"
