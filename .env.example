# ==========================================
# crave. Food Delivery Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://10.247.209.229:3000

# JWT Authentication Secret Key
JWT_SECRET=REDACTED_JWT_SECRET

# Neon Database Connection (PostgreSQL)
DATABASE_URL="postgresql://REDACTED_USER:REDACTED_PASSWORD@ep-REDACTED_HOST.us-east-2.aws.neon.tech/REDACTED_DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://REDACTED_USER:REDACTED_PASSWORD@ep-REDACTED_HOST.us-east-2.aws.neon.tech/REDACTED_DB?sslmode=require&channel_binding=require"

# Neon File Storage
NEON_BUCKET_UPLOADS="uploads"

# Redis Cache, Distributed Locks & Pub/Sub
REDIS_URL="redis://localhost:6379"

