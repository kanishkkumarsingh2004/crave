# ==========================================
# crave. Food Delivery Environment Configuration
# ==========================================

# Environment Mode
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=crave.

# JWT Authentication Secret Key
JWT_SECRET=REDACTED_JWT_SECRET

# Admin System Authorization Code
ADMIN_SECRET_CODE=CRAVE-SYS-8890

# Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/crave_db?schema=public"
