{
  "name": "crave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node server.js",
    "dev:ws": "node ws-server.js",
    "build": "turbo run //#build:next @crave/admin-app#build @crave/driver-app#build @crave/restaurant-app#build",
    "build:next": "prisma generate && next build --webpack",
    "rebuild": "turbo run //#build:next @crave/admin-app#build @crave/driver-app#build @crave/restaurant-app#build --force",
    "start": "node server.js",
    "start:ws": "node ws-server.js",
    "typecheck": "turbo run typecheck:ts",
    "typecheck:ts": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 test/*.test.ts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm exec prisma validate && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate:baseline": "prisma migrate resolve --applied 20261016000000_baseline_existing_schema",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:admin": "tsx scripts/create-admin.ts",
    "db:seed": "tsx scripts/seed-local-db.ts",
    "db:seed:full": "tsx scripts/seed-complete-data.ts",
    "loadtest:gps": "tsx scripts/gps-load-test.ts",
    "load-test": "k6 run load-tests/checkout-load-test.js",
    "load-test:ci": "k6 run --out json=load-test-results.json load-tests/checkout-load-test.js",
    "load-test:comprehensive": "k6 run load-tests/comprehensive-load-test.js",
    "load-test:smoke": "k6 run --env TEST_TYPE=smoke load-tests/comprehensive-load-test.js",
    "load-test:load": "k6 run --env TEST_TYPE=load load-tests/comprehensive-load-test.js",
    "load-test:stress": "k6 run --env TEST_TYPE=stress load-tests/comprehensive-load-test.js",
    "load-test:spike": "k6 run --env TEST_TYPE=spike load-tests/comprehensive-load-test.js",
    "load-test:soak": "k6 run --env TEST_TYPE=soak load-tests/comprehensive-load-test.js",
    "load-test:breakpoint": "k6 run --env TEST_TYPE=breakpoint load-tests/comprehensive-load-test.js",
    "load-test:websocket": "k6 run --env TEST_TYPE=websocket load-tests/comprehensive-load-test.js",
    "load-test:browser": "k6 run --env TEST_TYPE=browser load-tests/comprehensive-load-test.js",
    "load-test:prod": "k6 run --env BASE_URL=https://crave.apexonestudio.com --env WS_URL=wss://crave.apexonestudio.com/api/ws load-tests/comprehensive-load-test.js",
    "load-test:prod:smoke": "k6 run --env TEST_TYPE=smoke --env BASE_URL=https://crave.apexonestudio.com --env WS_URL=wss://crave.apexonestudio.com/api/ws load-tests/comprehensive-load-test.js",
    "load-test:prod:load": "k6 run --env TEST_TYPE=load --env BASE_URL=https://crave.apexonestudio.com --env WS_URL=wss://crave.apexonestudio.com/api/ws load-tests/comprehensive-load-test.js",
    "load-test:prod:stress": "k6 run --env TEST_TYPE=stress --env BASE_URL=https://crave.apexonestudio.com --env WS_URL=wss://crave.apexonestudio.com/api/ws load-tests/comprehensive-load-test.js",
    "load-test:prod:spike": "k6 run --env TEST_TYPE=spike --env BASE_URL=https://crave.apexonestudio.com --env WS_URL=wss://crave.apexonestudio.com/api/ws load-tests/comprehensive-load-test.js",
    "load-test:prod:websocket": "k6 run --env TEST_TYPE=websocket --env BASE_URL=https://crave.apexonestudio.com --env WS_URL=wss://crave.apexonestudio.com/api/ws load-tests/comprehensive-load-test.js",
    "format": "prettier --write .",
    "format:check": "turbo run format:check:prettier",
    "format:check:prettier": "prettier --check .",
    "dc:up": "docker compose up --build -d",
    "dc:down": "docker compose down",
    "dc:restart": "docker compose restart frontend backend",
    "dc:restart:all": "docker compose restart",
    "dc:rebuild": "docker compose build --no-cache frontend backend && docker compose up -d frontend backend",
    "dc:rebuild:frontend": "docker compose build --no-cache frontend && docker compose up -d frontend",
    "dc:rebuild:backend": "docker compose build --no-cache backend && docker compose up -d backend",
    "dc:rebuild:all": "docker compose down && docker compose up --build --force-recreate -d",
    "dc:clean": "docker compose down -v",
    "dc:wipe-all": "docker compose down -v --remove-orphans",
    "dc:logs": "docker compose logs -f",
    "dc:ps": "docker compose ps"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@neon/config": "^1.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "h3-js": "^4.5.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  }
}
