{
  "name": "crave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node server.js",
    "dev:ws": "node ws-server.js",
    "build": "pnpm build:next",
    "build:next": "prisma generate && next build --webpack",
    "rebuild": "pnpm build:next",
    "start": "node server.js",
    "start:ws": "node ws-server.js",
    "typecheck": "turbo run typecheck:ts",
    "typecheck:ts": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 test/*.test.ts",
    "test:db": "ALLOW_DATABASE_TESTS=true NODE_ENV=test node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/*.test.ts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm exec prisma validate && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate:baseline": "prisma migrate resolve --applied 20261016000000_baseline_existing_schema",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "push:generate-keys": "web-push generate-vapid-keys --json",
    "db:clean:data": "tsx scripts/clean-transactional-data.ts",
    "db:scrub": "tsx scripts/scrub-db-and-reset-passwords.ts",
    "db:admin": "tsx scripts/create-admin.ts",
    "db:seed": "tsx scripts/seed-local-db.ts",
    "db:seed:full": "tsx scripts/seed-complete-data.ts",
    "loadtest:gps": "tsx scripts/gps-load-test.ts",
    "load-test": "node scripts/run-load-test.mjs",
    "load-test:ci": "node scripts/run-load-test.mjs --out load-test-results.json",
    "load-test:help": "node scripts/run-load-test.mjs --help",
    "abuse-test": "node scripts/run-abuse-tests.mjs",
    "abuse-test:help": "node scripts/run-abuse-tests.mjs --help",
    "format": "prettier --write .",
    "format:check": "turbo run format:check:prettier",
    "format:check:prettier": "prettier --check .",
    "dc:up": "docker compose up --build -d",
    "dc:migrate": "docker compose run --rm migrate",
    "dc:with-db": "docker compose --profile with-db up --build -d",
    "dc:down": "docker compose down",
    "dc:restart": "docker compose restart frontend backend",
    "dc:restart:all": "docker compose restart",
    "dc:rebuild": "docker compose build --no-cache frontend backend && docker compose up -d frontend backend",
    "dc:rebuild:frontend": "docker compose build --no-cache frontend && docker compose up -d frontend",
    "dc:rebuild:backend": "docker compose build --no-cache backend && docker compose up -d backend",
    "dc:rebuild:all": "docker compose down && docker compose up --build --force-recreate -d",
    "dc:clean": "docker compose down -v",
    "dc:wipe-all": "docker compose down -v --remove-orphans",
    "dc:logs": "docker compose logs -f",
    "dc:ps": "docker compose ps"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "h3-js": "^4.5.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  }
}
