{
  "name": "crave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "onlyBuiltModules": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "node server.js",
    "dev:ws": "node ws-server.js",
    "build": "turbo run build:next",
    "build:next": "next build",
    "rebuild": "prisma generate && turbo run build:next",
    "start": "node server.js",
    "start:ws": "node ws-server.js",
    "typecheck": "turbo run typecheck:ts",
    "typecheck:ts": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:admin": "tsx scripts/create-admin.ts",
    "db:seed": "tsx scripts/seed-local-db.ts",
    "test": "turbo run test:jest",
    "test:jest": "jest",
    "test:watch": "jest --watch",
    "db:admin:docker": "tsx scripts/create-admin.ts",
    "test:coverage": "turbo run test:coverage",
    "load-test": "k6 run load-tests/checkout-load-test.js",
    "load-test:ci": "k6 run --out json=load-test-results.json load-tests/checkout-load-test.js",
    "format": "prettier --write .",
    "format:check": "turbo run format:check:prettier",
    "format:check:prettier": "prettier --check .",
    "dc:up": "docker compose up --build -d",
    "dc:down": "docker compose down",
    "dc:restart": "docker compose restart frontend backend",
    "dc:restart:all": "docker compose restart",
    "dc:rebuild": "docker rmi -f crave-food-delivery-frontend crave-food-delivery-backend 2>/dev/null || true && docker compose up --build -d frontend backend",
    "dc:rebuild:frontend": "docker compose stop frontend && docker rmi -f crave-food-delivery-frontend 2>/dev/null || true && docker compose up --build -d frontend",
    "dc:rebuild:backend": "docker compose stop backend && docker rmi -f crave-food-delivery-backend 2>/dev/null || true && docker compose up --build -d backend",
    "dc:rebuild:all": "docker compose down && docker compose up --build --force-recreate -d",
    "dc:clean": "docker compose down -v",
    "dc:wipe-all": "docker compose down -v --remove-orphans && docker rmi -f crave-food-delivery-frontend crave-food-delivery-backend 2>/dev/null || true",
    "dc:logs": "docker compose logs -f",
    "dc:ps": "docker compose ps"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.7",
    "h3-js": "^4.5.0",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "maplibre-gl": "^6.13.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@prisma/config": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.2",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  }
}
