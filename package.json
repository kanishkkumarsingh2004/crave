{
  "name": "crave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "onlyBuiltModules": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "NODE_ENV=development node server.js",
    "dev:ws": "node ws-server.js",
    "build": "next build",
    "rebuild": "prisma generate && next build",
    "start": "NODE_ENV=production node server.js",
    "start:ws": "node ws-server.js",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:fresh": "prisma db push --force-reset && pnpm db:seed",
    "db:seed": "NODE_ENV=development tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:admin": "tsx scripts/create-admin.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:admin:docker": "DATABASE_URL=postgresql://crave:crave_secret@localhost:5433/crave_db?schema=public tsx scripts/create-admin.ts",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dc:up": "docker compose up --build -d",
    "dc:down": "docker compose down",
    "dc:restart": "docker compose restart",
    "dc:clean": "docker compose down -v",
    "dc:fresh": "docker compose down -v && docker compose up --build --force-recreate -d",
    "dc:rebuild": "docker compose down -v && docker rmi -f crave-food-delivery-frontend crave-food-delivery-backend crave-food-delivery-db-init 2>/dev/null || true && docker compose up --build --force-recreate -d",
    "dc:rebuild:frontend": "docker compose stop frontend && docker rmi -f crave-food-delivery-frontend 2>/dev/null || true && docker compose up --build -d frontend",
    "dc:rebuild:backend": "docker compose stop backend && docker rmi -f crave-food-delivery-backend 2>/dev/null || true && docker compose up --build -d backend",
    "dc:logs": "docker compose logs -f",
    "dc:ps": "docker compose ps"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.5",
    "h3-js": "^4.5.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.12.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@prisma/config": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
