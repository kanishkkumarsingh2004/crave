# Credentials for the abuse / concurrency suite.
# Copy to load-tests/.env (gitignored) and adjust for your database.
#
# Every role may have its own password: SEED_<ROLE>_PASSWORD wins over
# SEED_PASSWORD, e.g. SEED_CUSTOMER_PASSWORD.
SEED_PASSWORD=1234567890

SEED_ADMIN_EMAIL=admin@crave.com
SEED_VENDOR_EMAIL=momobar@crave.com
SEED_RIDER_EMAIL=test@crave.com
SEED_CUSTOMER_EMAIL=

# The suite also knows these fallbacks, so it keeps working when an account
# only exists under its original address:
#   customer → kanishkkumar2004@gmail.com
#   rider    → test@gmail.com
