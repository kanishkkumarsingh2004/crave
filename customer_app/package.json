{
  "name": "@crave/customer-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "pnpm build && cap sync",
    "copy": "pnpm build && cap copy",
    "android": "pnpm sync && cap open android",
    "ios": "pnpm sync && cap open ios",
    "assets": "capacitor-assets generate --assetPath assets --android --iconBackgroundColor '#F4FF52' --iconBackgroundColorDark '#F4FF52' --splashBackgroundColor '#08110C' --splashBackgroundColorDark '#08110C' && capacitor-assets generate --assetPath assets --ios --iconBackgroundColor '#F4FF52' --iconBackgroundColorDark '#F4FF52' --splashBackgroundColor '#08110C' --splashBackgroundColorDark '#08110C'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "maplibre-gl": "6.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
